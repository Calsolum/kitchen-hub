# Copy this file to .env and fill in your own values. Never commit the real .env.

# Grocy admin > Settings > API keys
GROCY_API_KEY=

# Mealie default admin account, created on first container start
MEALIE_DEFAULT_EMAIL=
MEALIE_DEFAULT_PASSWORD=

# YouTube Data API v3 key (optional -- enables voice-driven video search)
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
